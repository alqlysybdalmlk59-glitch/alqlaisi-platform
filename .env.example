APP_NAME=Al Qulaisi
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1

# PostgreSQL
DATABASE_URL=postgresql+psycopg://CHANGE_ME:CHANGE_ME@127.0.0.1:5432/alqlaisi_db

# Authentication
JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google authentication
GOOGLE_CLIENT_ID=

# CORS: adjust for local development
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5500,http://localhost:8080
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
