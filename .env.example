APP_NAME=Al Qulaisi
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1

# Development: leave empty to use backend/alqulaisi.db (SQLite).
# Production: set a TLS-enabled PostgreSQL URL, for example:
# postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=

# Authentication. Replace this example in local .env with a unique random value.
JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google Web/server OAuth client ID; production startup requires it.
GOOGLE_CLIENT_ID=

# Exact local development origins only. Use exact HTTPS origins in production, never a wildcard.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5500,http://localhost:8080
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2,testserver
